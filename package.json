{
  "name": "starknet-id-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run check:network && next build && bun run check:bundle",
    "start": "next start",
    "lint": "eslint --max-warnings=0 'components/**/*.{ts,tsx}' 'hooks/**/*.{ts,tsx}' 'lib/**/*.ts' 'pages/**/*.{ts,tsx}' 'scripts/**/*.ts'",
